# Django
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
DB_NAME=aman_db
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=db
DB_PORT=5432

# Channels / Redis
REDIS_URL=redis://redis:6379/0

# Set to True only for local or CI tests that should use SQLite.
USE_SQLITE=False

# API idempotency
IDEMPOTENCY_PROCESSING_TIMEOUT_SECONDS=300

# Vite (the defaults work when Nginx proxies /api and /ws)
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=
