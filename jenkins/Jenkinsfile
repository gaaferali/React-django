pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        booleanParam(name: 'BUILD_IMAGES', defaultValue: true, description: 'Build the Docker images after tests pass')
        booleanParam(name: 'DEPLOY', defaultValue: false, description: 'Deploy the main branch with Docker Compose')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend checks') {
            steps {
                withEnv([
                    'USE_SQLITE=True',
                    'DEBUG=False',
                    'SECRET_KEY=jenkins-validation-secret-key-with-at-least-32-characters',
                    'ALLOWED_HOSTS=localhost,127.0.0.1,testserver',
                    'CORS_ALLOWED_ORIGINS=http://localhost',
                    'REDIS_URL='
                ]) {
                    sh '''
                        python3 -m venv .ci-venv
                        .ci-venv/bin/python -m pip install --upgrade pip
                        .ci-venv/bin/pip install -r backend/requirements.txt
                        cd backend
                        ../.ci-venv/bin/python manage.py makemigrations --check
                        ../.ci-venv/bin/python manage.py check
                        ../.ci-venv/bin/python manage.py test test --noinput
                    '''
                }
            }
        }

        stage('Frontend build') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'frontend/dist/**', fingerprint: true
                }
            }
        }

        stage('Container build') {
            when {
                expression { params.BUILD_IMAGES }
            }
            steps {
                sh 'docker compose config'
                sh 'docker compose build'
            }
        }

        stage('Deploy') {
            when {
                allOf {
                    branch 'main'
                    expression { params.DEPLOY }
                }
            }
            steps {
                withCredentials([file(credentialsId: 'aman-production-env', variable: 'AMAN_ENV_FILE')]) {
                    sh 'docker compose --env-file "$AMAN_ENV_FILE" up -d --build --remove-orphans'
                    sh 'docker compose --env-file "$AMAN_ENV_FILE" exec -T backend python manage.py check'
                }
            }
        }
    }

    post {
        always {
            deleteDir()
        }
    }
}
